<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>India Urban Stack</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{background:#e9edf2;font-family:"Segoe UI",Inter,Helvetica,Arial,sans-serif;overflow:auto}
  #wrap{width:100%;display:flex;justify-content:center;padding:20px 0}
  #scaler{transform-origin:top center}
  .slide{width:1600px;height:900px;background:#fff;padding:34px 36px 26px;
    display:flex;flex-direction:column;box-shadow:0 3px 24px rgba(0,0,0,.16)}

  header{border-bottom:3px solid #1e3a5f;padding-bottom:14px;margin-bottom:18px;flex:0 0 auto;
    display:flex;justify-content:space-between;align-items:flex-end}
  h1{font-size:44px;color:#1e3a5f;font-weight:700;letter-spacing:-.02em;line-height:1.05}
  .sub{font-size:20px;color:#5b6b7d;margin-top:7px}
  .hint{font-size:14px;color:#8b98a6;font-style:italic;white-space:nowrap;padding-bottom:4px}

  .body{flex:1 1 auto;display:flex;gap:26px}

  .stack{width:1026px;display:flex;flex-direction:column;gap:11px}
  .layer{flex:1 1 0;display:flex;align-items:center;gap:14px;
    background:#f5f8fa;border:1px solid #d3dce6;border-radius:6px;padding:10px 14px}
  .lname{width:152px;flex:0 0 152px;font-size:17px;font-weight:700;color:#1e3a5f;
    text-transform:uppercase;letter-spacing:.02em;line-height:1.2}
  .chips{flex:1 1 auto;display:flex;flex-wrap:wrap;gap:8px;align-content:center}
  .c{font-size:16px;background:#fff;border:1px solid #bfcbd9;border-radius:5px;
     padding:7px 11px;color:#22364d;line-height:1.15;white-space:nowrap}
  .c.key{background:#1e3a5f;border-color:#1e3a5f;color:#fff;font-weight:600}
  .c.upyog{border:3px solid #1e3a5f;color:#1e3a5f;font-weight:700;padding:5px 11px}
  .c.rail{background:#eef2f6;border-color:#ccd6e0;color:#3d4f63;font-size:15px;padding:6px 10px}
  .c.flag{border-style:dashed;color:#6b7a8c}
  .cl{border-left:6px solid #d97706}

  .panel{width:482px;display:flex;flex-direction:column;gap:10px}
  .ptitle{font-size:17px;font-weight:700;color:#1e3a5f;text-transform:uppercase;letter-spacing:.02em;flex:0 0 auto}
  .groups{flex:1 1 auto;display:flex;flex-direction:column;gap:9px}
  .g{flex:1 1 0;border:1px solid #d3dce6;border-left:6px solid #4a6fa5;border-radius:5px;
     padding:9px 13px;background:#fafcfd;display:flex;flex-direction:column;justify-content:center}
  .g.para{border-left-color:#7a5ea8;background:#faf8fd}
  .g.mkt{border-left-color:#4d8b7a;background:#f7fcfa}
  .g h3{font-size:17px;color:#1e3a5f;font-weight:700;line-height:1.2}
  .g p{font-size:14px;color:#5b6b7d;margin-top:4px;line-height:1.35}

  .attach{flex:0 0 auto;display:flex;gap:9px}
  .a{flex:1 1 0;border:1px dashed #a8b6c5;border-radius:5px;padding:8px 4px;text-align:center}
  .a b{display:block;font-size:15px;color:#1e3a5f}
  .a span{font-size:12px;color:#7a8899;line-height:1.2;display:block;margin-top:3px}

  footer{flex:0 0 auto;margin-top:16px;padding-top:12px;border-top:1px solid #d3dce6;
    display:flex;justify-content:space-between;gap:30px;align-items:flex-start}
  .legend{font-size:14px;color:#5b6b7d;line-height:1.45;width:62%}
  .legend b{color:#d97706}
  .legend .note{font-size:12px;color:#98a5b3;margin-top:5px}
  .rule{font-size:15px;color:#1e3a5f;font-weight:600;text-align:right;line-height:1.35;width:34%}

  /* clickable affordance */
  [data-k]{cursor:pointer;transition:box-shadow .12s,transform .12s}
  [data-k]:hover{box-shadow:0 0 0 3px rgba(30,58,95,.28);transform:translateY(-1px)}

  /* modal */
  #ov{position:fixed;inset:0;background:rgba(16,28,42,.55);display:none;
      align-items:center;justify-content:center;padding:24px;z-index:99}
  #ov.on{display:flex}
  #card{background:#fff;max-width:660px;width:100%;max-height:86vh;overflow:auto;
    border-radius:10px;padding:28px 32px 26px;box-shadow:0 12px 48px rgba(0,0,0,.3);position:relative}
  #card .kick{font-size:12px;letter-spacing:.09em;text-transform:uppercase;color:#8b98a6;font-weight:700}
  #card h2{font-size:26px;color:#1e3a5f;margin:6px 0 10px;line-height:1.15}
  #card .def{font-size:16px;color:#3d4f63;line-height:1.5;margin-bottom:14px}
  #card ul{margin:0 0 14px 18px}
  #card li{font-size:15px;color:#40515f;line-height:1.5;margin-bottom:6px}
  #card .flagbox{font-size:14px;line-height:1.45;padding:11px 14px;border-radius:6px;
    background:#fdf6ec;border-left:5px solid #d97706;color:#7a5a20}
  #card .flagbox b{color:#a8620a}
  #x{position:absolute;top:14px;right:16px;border:0;background:#eef2f6;color:#3d4f63;
     width:32px;height:32px;border-radius:16px;font-size:18px;cursor:pointer;line-height:1}
  #x:hover{background:#dde5ec}
</style>
</head>
<body>
<div id="wrap"><div id="scaler">
<div class="slide">

  <header>
    <div>
      <h1>India Urban Stack</h1>
      <div class="sub">The Centre standardises the interface. The State owns the data. Nothing that works today gets switched off.</div>
    </div>
    <div class="hint">Click any box for detail</div>
  </header>

  <div class="body">

    <div class="stack">
      <div class="layer">
        <div class="lname" data-k="L1">Solutions</div>
        <div class="chips">
          <span class="c upyog" data-k="upyog">UPYOG</span>
          <span class="c" data-k="stateplat">State platforms</span>
          <span class="c" data-k="mission">Mission systems &amp; ICCC</span>
          <span class="c" data-k="mktapps">Market &amp; civil society apps</span>
        </div>
      </div>

      <div class="layer">
        <div class="lname" data-k="L2">Intelligence</div>
        <div class="chips">
          <span class="c" data-k="pred">Predictive</span>
          <span class="c" data-k="gen">Generative</span>
          <span class="c" data-k="agent">Agentic</span>
          <span class="c key" data-k="assure">Assurance &amp; audit</span>
          <span class="c cl" data-k="hazfc">Hazard forecasting</span>
        </div>
      </div>

      <div class="layer">
        <div class="lname" data-k="L3">Common services</div>
        <div class="chips">
          <span class="c" data-k="specs">Specifications &amp; APIs</span>
          <span class="c key" data-k="cert">Conformance &amp; certification</span>
          <span class="c" data-k="dx">Data exchange</span>
          <span class="c" data-k="rules">Rules engines</span>
          <span class="c" data-k="consent">Consent</span>
          <span class="c" data-k="pay">Payments</span>
        </div>
      </div>

      <div class="layer">
        <div class="lname" data-k="L4">Core registries</div>
        <div class="chips">
          <span class="c key" data-k="premise">Premise / Place ID</span>
          <span class="c" data-k="person">Person &amp; entity</span>
          <span class="c cl" data-k="asset">Asset</span>
          <span class="c cl" data-k="spatial">Spatial &amp; jurisdiction</span>
          <span class="c key cl" data-k="oblig">Obligation</span>
          <span class="c cl" data-k="fiscal">Fiscal &amp; accounts</span>
        </div>
      </div>

      <div class="layer">
        <div class="lname" data-k="L5">DPI rails</div>
        <div class="chips">
          <span class="c rail" data-k="aadhaar">Aadhaar</span>
          <span class="c rail" data-k="upi">UPI</span>
          <span class="c rail" data-k="dlocker">DigiLocker</span>
          <span class="c rail" data-k="depa">DEPA</span>
          <span class="c rail" data-k="beckn">Beckn</span>
          <span class="c rail flag" data-k="digipin">DIGIPIN *</span>
          <span class="c rail flag" data-k="vahan">Vahan *</span>
          <span class="c rail" data-k="ulpin">ULPIN</span>
          <span class="c rail cl" data-k="gati">Gati Shakti &amp; Bhuvan</span>
          <span class="c rail" data-k="bhashini">Bhashini</span>
          <span class="c rail" data-k="iudx">IUDX</span>
        </div>
      </div>
    </div>

    <div class="panel">
      <div class="ptitle">Who plugs in</div>
      <div class="groups">
        <div class="g" data-k="mohua">
          <h3>MoHUA &amp; missions</h3>
          <p>AMRUT · SBM-U · PMAY-U · Smart Cities · NULM · UCF<br>Defines specs, certifies, funds</p>
        </div>
        <div class="g" data-k="state">
          <h3>State H&amp;UD</h3>
          <p>Owns and governs the data. Chooses platform and sequence</p>
        </div>
        <div class="g" data-k="ulb">
          <h3>ULBs</h3>
          <p>Operate services. Generate the records the stack carries</p>
        </div>
        <div class="g para" data-k="para">
          <h3>Parastatals &amp; agencies</h3>
          <p>Water boards · development authorities · transport · DISCOMs · pollution control</p>
        </div>
        <div class="g mkt" data-k="market">
          <h3>Market &amp; samaj</h3>
          <p>Providers · startups · lenders · NGOs · RWAs · informal sector</p>
        </div>
      </div>
      <div class="attach">
        <div class="a" data-k="adopt"><b>Adopt</b><span>hosted instance</span></div>
        <div class="a" data-k="buildon"><b>Build on</b><span>blocks and APIs</span></div>
        <div class="a" data-k="interop"><b>Interoperate</b><span>wrap, don't replace</span></div>
      </div>
    </div>

  </div>

  <footer>
    <div class="legend" data-k="climate">
      <b>■ Climate resilience thread</b> — carried inside the core, not as a separate vertical. Hazard and emissions attributes on premise and asset records, exposure layers in the spatial base, resilience duties in the obligation registry, climate-conditional finance in fiscal records.
      <div class="note">* DIGIPIN and Vahan shown as candidate rails. API availability and licence terms for urban use unverified.</div>
    </div>
    <div class="rule">Whoever writes the specification should not also be its sole implementer.</div>
  </footer>

</div>
</div></div>

<div id="ov"><div id="card">
  <button id="x" aria-label="Close">&times;</button>
  <div class="kick" id="k-kick"></div>
  <h2 id="k-title"></h2>
  <div class="def" id="k-def"></div>
  <ul id="k-list"></ul>
  <div class="flagbox" id="k-flag" style="display:none"></div>
</div></div>

<script>
var D = {
L1:["Layer","Solutions","What States, cities, missions and the market build on top. The stack does not choose winners here.",
 ["Plural by design. Several implementations coexist and any one is replaceable.",
  "Nothing in this layer is switched off to join the stack.",
  "Conformance is what makes a solution trustworthy, not who built it."],
 "Open question: does the stack publish a catalogue of certified solutions, and who curates it?"],
upyog:["Solution","UPYOG","The best-supported implementation of the stack. It is not the stack itself.",
 ["Open source, recognised as a Digital Public Good, roughly 16 to 18 service modules depending on the source consulted.",
  "The distinction is UPI versus a bank's app. The rail makes many apps possible and makes any one replaceable.",
  "For small ULBs with no IT capacity, a hosted UPYOG instance is the realistic entry point."],
 "Tension to resolve: eGov built UPYOG and would author the specification. Holding both weakens trust with States. Pick one."],
stateplat:["Solution","State platforms","States running their own systems stay on them and still participate.",
 ["K-SMART in Kerala, SUJOG in Odisha, mSeva in Punjab, Municipal ERP in Andhra Pradesh.",
  "These already share data to national dashboards. The stack formalises what works rather than asking anyone to switch.",
  "Kerala reports a per-capita platform cost far below a comparable standalone city project, which is the economic case for state-level scale."],
 "Figures on per-capita cost come from an eGov policy brief and should be re-verified before external use."],
mission:["Solution","Mission systems & ICCC","Existing central and state mission portals, wrapped rather than replaced.",
 ["Roughly ₹1.64 lakh crore already invested under the Smart Cities Mission, with an ICCC in all 100 cities.",
  "Wrapping is the only affordable path given that sunk investment.",
  "Each was scoped and judged by one scheme's outcomes, which is why they do not add up to a city."],
 null],
mktapps:["Solution","Market & civil society apps","Third-party applications built on published specifications.",
 ["Certified once, deployable across States, which is the commercial reason to build.",
  "Includes NGO and RWA tools, not only commercial products.",
  "This layer is where the stack's value becomes visible to a citizen."],
 null],

L2:["Layer","Intelligence","Three distinct capability classes, not one thing called AI.",
 ["Separating predictive, generative and agentic matters because each has a different failure mode and a different assurance requirement.",
  "What changed since NUIS: unstructured material such as DPRs, master plans, tariff orders and complaint text can now be made machine-readable without restructuring every ULB system.",
  "Voice-first access changes the inclusion equation more than any app has."],
 "Placement disagreement: agent identity and permissioning arguably belong in the common core, not here. Left in this layer for slide legibility."],
pred:["Capability","Predictive","Forecasting from historical and sensor data.",
 ["Revenue and demand forecasting, asset failure prediction, flood and heat risk.",
  "Requires longitudinal records, which most ULBs only now have after five years of transaction data.",
  "Lowest assurance burden of the three classes because outputs advise rather than act."],
 null],
gen:["Capability","Generative","Turning unstructured material into structured, queryable form and back.",
 ["Making plans, byelaws and tariff orders machine-readable without a manual digitisation programme.",
  "Multilingual and voice interfaces for citizens and frontline staff.",
  "Summarisation for officers who currently reconcile across three systems by hand."],
 "Risk: fluent output that is wrong is harder to catch than a blank field. Provenance must travel with every generated artefact."],
agent:["Capability","Agentic","Systems that take multi-step action on behalf of a person or an office.",
 ["Needs agent identity, scoped permissions, non-repudiation and an escalation path to a human.",
  "Without a record that an action was taken by an agent rather than a person, accountability dissolves.",
  "This is the class the stack must govern most tightly and the one no Indian sectoral stack has specified yet."],
 "Open question: does an agent get an entry in the participant registry, and who is liable for its actions?"],
assure:["Core service","Assurance & audit","The framework that makes intelligence usable in government.",
 ["Evaluation before deployment, oversight during, audit after.",
  "Applies differently to each capability class rather than as one blanket policy.",
  "Automated exclusion is the harm to design against, not model accuracy in the abstract."],
 null],
hazfc:["Climate","Hazard forecasting","Risk prediction against places and assets, not against wards in the abstract.",
 ["Draws on exposure layers in the spatial base and condition data in the asset registry.",
  "Useful only if the output resolves to a premise or an asset that someone is accountable for.",
  "Connects to climate-conditional finance: a funder can price a plan built on this."],
 null],

L3:["Layer","Common services","The rails everyone reuses so no ULB builds them alone.",
 ["This is where the stack earns adoption, since it must be cheaper than building alone.",
  "There is no urban regulator, so nothing here can be mandated. It has to be worth adopting.",
  "Capacity varies more in urban than in any other sector. A standard written for the top decile is unimplementable in the rest."],
 null],
specs:["Common service","Specifications & APIs","Published open specifications and a documented API library.",
 ["The actual deliverable of the stack. Everything else is downstream of agreement here.",
  "Versioning and support duration need an owner, or States cannot plan upgrades.",
  "Borrowed pattern: ABDM defined the design centrally and left the records with whoever created them."],
 "Governance question: who decides what enters a specification, and how are States represented in that decision?"],
cert:["Common service","Conformance & certification","Automated tests that verify a system implements the specification correctly.",
 ["Also the measurement instrument for adoption. Percentage conformance is a countable number.",
  "IES proposes self-declaration with automated test suites, escalating to independent certifiers only where systemic risk warrants it. A sensible model for urban.",
  "Certification that travels across States is the commercial incentive for vendors."],
 "Principle: whoever writes the specification should not also certify against it and implement it. Hold at most one."],
dx:["Common service","Data exchange","Moving records between systems, not reports to dashboards.",
 ["Today dashboards receive totals. You can see how many, never which or where.",
  "Federated: data stays with the custodian. The exchange standardises the interface only.",
  "IUDX exists for urban data exchange and should be assessed rather than rebuilt."],
 null],
rules:["Common service","Rules engines","Policy held as executable data rather than as PDF documents.",
 ["Development control rules, FSI and height norms, tariff and fee schedules, subsidy eligibility.",
  "Same pattern as the Policy Pack concept in the India Energy Stack, where multiple billing systems running one pack produce identical results.",
  "Enables rule-based approvals in place of case-by-case exemptions, which the Economic Survey asks for."],
 "Boundary: only deterministic, objectively verifiable provisions convert. Anything requiring discretion stays with a human."],
consent:["Common service","Consent","Permissioned data flows with an audit trail, aligned to the DPDP Act.",
 ["Reuse the DEPA and Account Aggregator pattern rather than inventing an urban consent framework.",
  "Consent fatigue is a real adoption risk. Willingness to share cannot be assumed.",
  "Particularly load-bearing for informal workers, who need to be visible to the city without being exposed by it."],
 null],
pay:["Common service","Payments","Taxes, fees, entitlements and refunds on existing rails.",
 ["UPI and BBPS already work. Nothing to build here.",
  "The harder problem is reconciliation into municipal accounts, not collection.",
  "Links directly to the fiscal registry and to bankability."],
 null],

L4:["Layer","Core registries","Shared definitions, so that two systems mean the same thing.",
 ["Urban has no single unit of transaction the way power has a kilowatt-hour or agriculture has a farmer and a plot. Except place.",
  "Everything a city does happens somewhere. Place is the only thing all its systems have in common and the one thing none of them agree on.",
  "Federation is the design, not a compromise. States build and own their registries on a common national design."],
 null],
premise:["Registry","Premise / Place ID","A parcel or premise that resolves to the same record twice.",
 ["The join key for property tax, water, sewerage, permissions, waste, entitlements and hazard exposure.",
  "Candidate anchors: DIGIPIN, State property survey IDs, ULPIN. Resolution between them is the real work.",
  "Design warning from AgriStack: its registry was built around cultivated land and structurally excluded landless labourers. A title-anchored urban premise ID will exclude tenants, informal settlements and migrants the same way."],
 "Unresolved: build on DIGIPIN, on State survey IDs, or a new national scheme, and who operates resolution between them?"],
person:["Registry","Person & entity","Residents, tenants, workers and businesses, identified once and reused with consent.",
 ["Separating occupancy from ownership is the design decision that determines who gets included.",
  "Portability matters: a worker moving between cities should carry entitlement without a fresh survey.",
  "The Survey records that PM SVANidhi introduced a letter of recommendation simply to bypass repeat ULB surveys. That is the cost of not having this."],
 null],
asset:["Registry","Asset","Municipal and utility assets with condition, lifecycle and exposure attributes.",
 ["Drains, pipes, pumps, vehicles, streetlights, buildings, treatment plants.",
  "Carries hazard and emissions attributes, which is how climate enters the core rather than sitting in a separate study.",
  "A published asset register is also a precondition for issuing a municipal bond."],
 null],
spatial:["Registry","Spatial & jurisdiction","A shared spatial base with versioned ward and jurisdiction geometry.",
 ["India does not agree how urban it is. Statutory urbanisation in Kerala rises from about 54 per cent to an estimated 83 per cent once spatially identified settlements are counted.",
  "Growth is overwhelmingly outward and follows transport corridors, beyond municipal limits and beyond municipal systems.",
  "The Survey's remedy, harmonised spatial classification as a standing instrument, is a registry problem rather than a study."],
 null],
oblig:["Registry","Obligation","Who is accountable for what, and who is required to publish it.",
 ["The Survey's diagnosis is that enforcement fails as coordination, not capacity, because responsibility is dispersed across agencies.",
  "Shared identifiers let two systems agree they mean the same drain. They do not establish who must maintain it.",
  "This is the registry that converts a political diagnosis into something a stack can hold."],
 "Not yet agreed by the working group. This is a proposition, not a settled component."],
fiscal:["Registry","Fiscal & accounts","Machine-readable municipal accounts and revenue records, to a published standard.",
 ["Property tax raises about 0.15 per cent of GDP against 0.3 to 0.6 per cent in comparable economies.",
  "Own-source revenue covers 30 to 40 per cent of expenditure in large cities and under 20 per cent in smaller ones.",
  "UCF requires at least 50 per cent market financing per project and releases funds against geo-tagged verified progress. That needs data that does not exist today."],
 "This is the strongest adoption lever urban has, since it is the only place where money is conditioned on the data."],

L5:["Layer","DPI rails","Assemble, do not build. Almost nothing at this layer needs inventing.",
 ["The work is agreement on definitions and interfaces, not construction.",
  "Each rail has different maturity, licence terms and API availability for urban use. Several are attractive on paper only.",
  "An audit of what already exists and can genuinely be reused belongs in the blueprint phase."],
 null],
aadhaar:["Rail","Aadhaar","Identity, proven once.",["Mature and universally available.","Cannot be the sole route to service, or exclusion follows.","Pairs with the person and entity registry rather than replacing it."],null],
upi:["Rail","UPI","Payments, collections, refunds and entitlement transfer.",["Mature. Nothing to build.","Reconciliation into municipal accounts remains the unsolved half."],null],
dlocker:["Rail","DigiLocker","Issuing and reusing verified documents.",["Removes repeat document submission across the six-interaction citizen journey.","Municipal certificates and permissions can be issued into it."],null],
depa:["Rail","DEPA","Consent-based data sharing framework.",["Account Aggregator and ABDM both use this pattern.","Gives urban a consent model without inventing one."],null],
beckn:["Rail","Beckn","Open network protocol for discovery, ordering and fulfilment.",
 ["Suits mobility, waste aggregation, tankers, repairs and care services where a citizen can choose a provider.",
  "Suits trunk monopoly services poorly. You cannot choose your sewer.",
  "Also the basis of the Unified Energy Interface, so there is a sectoral precedent to study."],
 "Caution: the deck currently uses the network idea in three different senses. Vendor marketplace, private data contribution and citizen-facing service network are not the same thing."],
digipin:["Rail","DIGIPIN","A geocoded digital addressing scheme.",
 ["A candidate anchor for the premise identifier, or a complement to State survey IDs.",
  "Addressing and property identification are related but distinct. One names a location, the other identifies a legal or fiscal object."],
 "Unverified: current adoption status, licence terms and API availability for urban use. Confirm before this goes on a slide externally."],
vahan:["Rail","Vahan","The national vehicle registration database, held by MoRTH.",
 ["Potentially relevant to parking, permits, waste-fleet tracking, commercial vehicle enforcement and transport planning.",
  "About 2.5 lakh waste collection vehicles nationally, none of them currently joined to municipal asset records."],
 "Unverified: whether Vahan exposes APIs usable by ULBs, and on what terms. I have not confirmed this."],
ulpin:["Rail","ULPIN","Unique land parcel identifier, under the land records modernisation programme.",
 ["Alongside NGDRS for registration, and State systems such as Bhu Bharati in Telangana and Bhu Suraksha in Karnataka.",
  "The closest existing thing to a national parcel identifier.",
  "Coverage in urban areas is weaker than in rural, which is precisely where the difficulty sits."],
 null],
gati:["Rail","Gati Shakti & Bhuvan","National geospatial layers and satellite imagery.",
 ["Provides the common map beneath every plan, plus hazard and terrain layers.",
  "Carries the climate thread into the spatial base.",
  "Growth monitoring against plan assumptions becomes a standing register rather than an occasional study."],
 null],
bhashini:["Rail","Bhashini","Multilingual translation and speech.",
 ["Voice-first is the access unlock. Evidence from agriculture: MahaVISTAAR moved from a few hundred to roughly 10,000 daily queries after switching from an app to a feature-phone voice line.",
  "Matters most for exactly the citizens least served by portals."],
 null],
iudx:["Rail","IUDX","India Urban Data Exchange, developed with IISc.",
 ["Already scoped for urban data exchange between cities and local bodies.",
  "Should be assessed for reuse rather than rebuilt.",
  "Adoption and licence terms for this use need verification."],
 null],

mohua:["Participant","MoHUA & national missions","Defines specifications, certifies, funds and commits convergence.",
 ["AMRUT, SBM-U, PMAY-U, Smart Cities, NULM and the Urban Challenge Fund all land in the same ward.",
  "The Centre can enable, fund and incentivise. It cannot mandate into a municipality. Any design assuming compliance gets paper compliance.",
  "UCF is the sharpest instrument available: ₹1 lakh crore, reform conditions at every approval and tranche point, and a reform portal that does not yet exist."],
 "Institutional home unresolved: a unit inside MoHUA, an existing institution as custodian, or a dedicated sponsored entity."],
state:["Participant","State H&UD departments","Owns and governs the data. Chooses platform, partner and sequence.",
 ["Local government is a State subject. This is not a courtesy, it is the constraint.",
  "State-led unified platforms cut per-capita cost sharply and stop smaller towns being left behind.",
  "Risk to avoid: state-led must not become digital recentralisation. ULBs need to keep autonomy over their data and local policy flexibility."],
 null],
ulb:["Participant","ULBs","Operate services and generate the records the stack carries.",
 ["Capacity ranges from corporations with full IT departments to municipalities with one operator.",
